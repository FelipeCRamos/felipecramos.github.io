---
// Share image templates. scripts/build-assets.mjs screenshots these into public/og.
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import { ui, type Lang } from '../../i18n';

export async function getStaticPaths() {
  const studies = await getCollection('work');
  const pages: { params: { key: string }; props: { tag: string; title: string; sub: string } }[] = [];
  for (const lang of ['en', 'pt'] as Lang[]) {
    pages.push({ params: { key: `${lang}-home` }, props: { tag: ui[lang].heroTag, title: 'Felipe Ramos', sub: ui[lang].heroLine } });
  }
  for (const s of studies) {
    const [lang, slug] = s.id.split('/');
    pages.push({ params: { key: `${lang}-${slug}` }, props: { tag: s.data.context, title: s.data.title, sub: s.data.result } });
  }
  return pages;
}
const { tag, title, sub } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>{title}</title></head>
  <body style="margin:0;width:1200px;height:630px;overflow:hidden;background:#042b59;color:#f5faff">
    <div style="height:16px;background:#13b9fd"></div>
    <div style="padding:64px 72px;display:grid;gap:26px;align-content:space-between;height:614px;box-sizing:border-box">
      <div style="display:grid;gap:22px">
        <div style="font:700 24px/1.3 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:#13b9fd">{tag}</div>
        <div style="font:700 96px/.98 var(--display);text-transform:uppercase;text-wrap:balance">{title}</div>
        <div style="font:400 32px/1.35 var(--body);max-width:1000px;color:#d6e4f2">{sub}</div>
      </div>
      <div style="font:400 24px/1.3 var(--mono);color:#b3cbe3">Felipe Ramos · Senior Mobile Engineer</div>
    </div>
  </body>
</html>
